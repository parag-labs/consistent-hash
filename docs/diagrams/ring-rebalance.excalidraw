    {
      "type": "text",
      "id": "text-24",
      "x": 700,
      "y": 470,
      "width": 240,
      "height": 32,
      "text": "D takes only the A -> D arc",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#c92a2a",
      "textAlign": "center",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-25",
      "x": 40,
      "y": 500,
      "width": 880,
      "height": 35,
      "text": "Single point per node -> lumpy load (~100% CoV). A couple hundred virtual nodes",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-26",
      "x": 40,
      "y": 532,
      "width": 880,
      "height": 35,
      "text": "tighten the spread to ~20-27% and make removal graceful: a departing node's keys",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-27",
      "x": 40,
      "y": 564,
      "width": 880,
      "height": 35,
      "text": "scatter across many neighbors instead of dumping onto the next node clockwise.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ],
